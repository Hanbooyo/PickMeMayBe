{
  "name": "pick-me-maybe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-directed raffle presentation platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo:api": "tsc -p tsconfig.json && npm.cmd --workspace @pick-me-maybe/api run start",
    "demo:preview": "tsc -p tsconfig.json && node scripts/create-preview-report.mjs",
    "demo:smoke": "tsc -p tsconfig.json && node scripts/demo-smoke.mjs",
    "demo:web": "tsc -p tsconfig.json && node scripts/serve-web.mjs",
    "render:sample": "tsc -p tsconfig.json && npm.cmd --workspace @pick-me-maybe/renderer run render:sample",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
